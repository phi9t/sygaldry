# Justfile for MLSys image management.
# Generated by zephyr_mlsys_vendor.sh -- customize as needed.
#
# Usage:
#   just build       # Build the MLSys Docker image
#   just run <cmd>   # Run a command in the image
#   just check       # Verify the vendored kit

kit := ".zephyr-mlsys"

# Build the baked MLSys Docker image from config.yaml.
build *args:
    {{kit}}/bin/build-mlsys.sh --config {{kit}}/config.yaml {{args}}

# Rebuild even if image.lock exists.
rebuild:
    {{kit}}/bin/build-mlsys.sh --config {{kit}}/config.yaml --force-rebuild

# Run a command inside the baked image (GPU enabled by default).
run *cmd:
    {{kit}}/bin/launch-mlsys.sh -- {{cmd}}

# Run a command without GPU access.
run-no-gpu *cmd:
    {{kit}}/bin/launch-mlsys.sh --no-gpu -- {{cmd}}

# Run a command with repo mounted read-only.
run-ro *cmd:
    {{kit}}/bin/launch-mlsys.sh --ro -- {{cmd}}

# Quick check that the vendored kit is intact.
check:
    @test -f {{kit}}/config.yaml && echo "config.yaml: OK" || echo "config.yaml: MISSING"
    @test -x {{kit}}/bin/build-mlsys.sh && echo "build-mlsys.sh: OK" || echo "build-mlsys.sh: MISSING"
    @test -x {{kit}}/bin/launch-mlsys.sh && echo "launch-mlsys.sh: OK" || echo "launch-mlsys.sh: MISSING"
    @test -f {{kit}}/bin/_build_helper.py && echo "_build_helper.py: OK" || echo "_build_helper.py: MISSING"
    @test -f {{kit}}/container/entrypoint.sh && echo "entrypoint.sh: OK" || echo "entrypoint.sh: MISSING"
    @test -f {{kit}}/container/run-job.sh && echo "run-job.sh: OK" || echo "run-job.sh: MISSING"
