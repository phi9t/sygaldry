#!/bin/bash
#
# Sygaldry CLI
# =============
#
# Unified entry point for the Sygaldry container infrastructure.
#
# INSTALL
# -------
#   ln -s /mnt/data_infra/workspace/sygaldry/bin/sygaldry /usr/local/bin/sygaldry
#
# USAGE
# -----
#   sygaldry                            # Interactive shell (default)
#   sygaldry shell [--repo .]           # Explicit interactive shell
#   sygaldry run -- <command>           # Run a command in container
#   sygaldry job run <name> -- <cmd>    # Start a background job
#   sygaldry job status <name>          # Check job status
#   sygaldry job tail <name>            # Stream job logs
#   sygaldry config show                # Show effective configuration
#   sygaldry validate [--flags]         # Run validation
#   sygaldry version                    # Show versions
#   sygaldry --help                     # Show this help

set -eu -o pipefail

# Resolve SYGALDRY_HOME from this script's location (follows symlinks)
SYGALDRY_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export SYGALDRY_HOME

# Prefer the Rust binary when available (graceful fallback to bash dispatcher)
ZEPHYR_BIN="${SYGALDRY_HOME}/crates/zephyr/target/release/zephyr"
if [[ -x "${ZEPHYR_BIN}" ]]; then
    case "${1:-}" in
        shell|run|job|build|config|stage|validate|init|gpu-check|verify-spack|uv-install|hf-download|entrypoint)
            exec "${ZEPHYR_BIN}" "$@"
            ;;
    esac
fi

readonly LAUNCHER="${SYGALDRY_HOME}/container/launch_container.sh"
readonly JOB_RUNNER="${SYGALDRY_HOME}/tools/zephyr_job"

show_help() {
    cat <<'EOF'
Usage: sygaldry [subcommand] [options]

Subcommands:
  shell             Interactive shell (default if no subcommand)
  run               Run a command in the container
  job               Manage background jobs (run/status/tail/stop/health)
  k3s               K3s dev pods and batch jobs (enter/job/setup)
  sail              SAIL agentic improvement loop (discover/worker/run/cron)
  config show       Show effective configuration
  snapshot          Build snapshot images (spack, mlsys, or all)
  validate          Run validation suite
  completions       Print bash completion script (source or redirect)
  version           Show component versions

Options (passed to launcher):
  --repo <path>     Enable multi-repo mode
  --entrypoint <n>  Select entrypoint (default: default.sh)
  --help            Show this help

Examples:
  sygaldry                              # Interactive shell
  sygaldry --repo . -- python train.py  # Run command in current repo
  sygaldry job run train -- "python train.py"
  sygaldry job status train
  sygaldry sail discover                # Preview discovered issues
  sygaldry sail --dry-run               # Dry-run SAIL (no LLM calls)
  sygaldry sail                         # Run SAIL improvement loop
  sygaldry sail worker                  # Start Temporal worker
  sygaldry sail cron                    # Run unattended SAIL cron wrapper once
  sygaldry sail analyze-run --run-dir /path/to/run
  sygaldry config show
  sygaldry snapshot spack               # Build spack snapshot
  sygaldry snapshot vllm sglang --push  # Build + push MLSys images
  sygaldry validate --quick
EOF
}

show_version() {
    echo "Sygaldry CLI"
    echo "  Home: ${SYGALDRY_HOME}"
    if [[ -f "${SYGALDRY_HOME}/.git/HEAD" ]]; then
        local ref
        ref="$(git -C "${SYGALDRY_HOME}" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
        echo "  Git:  ${ref}"
    fi
}

case "${1:-}" in
    --help|-h|help)
        show_help
        exit 0
        ;;
    version|--version)
        show_version
        exit 0
        ;;
    shell)
        shift
        exec "${LAUNCHER}" "$@"
        ;;
    run)
        shift
        exec "${LAUNCHER}" --entrypoint run-job "$@"
        ;;
    job)
        shift
        exec "${JOB_RUNNER}" "$@"
        ;;
    config)
        shift
        case "${1:-}" in
            show)
                shift
                exec "${LAUNCHER}" --print-effective-config "$@"
                ;;
            *)
                echo "Usage: sygaldry config show" >&2
                exit 2
                ;;
        esac
        ;;
    snapshot)
        shift
        exec "${SYGALDRY_HOME}/container/snapshot_all.sh" "$@"
        ;;
    validate)
        shift
        exec "${SYGALDRY_HOME}/validate_all.sh" "$@"
        ;;
    sail)
        shift
        case "${1:-}" in
            discover)
                shift
                exec python3 "${SYGALDRY_HOME}/tools/agentic/discover_issues.py" \
                    --repo-dir "${SYGALDRY_HOME}" "$@"
                ;;
            worker)
                shift
                cd "${SYGALDRY_HOME}/temporal"
                exec go run ./cmd/worker "$@"
                ;;
            cron)
                shift
                exec "${SYGALDRY_HOME}/tools/agentic/sail_cron.sh" "$@"
                ;;
            analyze-run)
                shift
                exec python3 "${SYGALDRY_HOME}/tools/agentic/analyze_sail_run.py" "$@"
                ;;
            validate-plan)
                shift
                cd "${SYGALDRY_HOME}/temporal"
                exec go run ./cmd/orchestrate validate \
                    -plan "${SYGALDRY_HOME}/tools/agentic/improvement_loop.yaml" "$@"
                ;;
            *)
                exec "${SYGALDRY_HOME}/tools/agentic/run_improvement_loop.sh" "$@"
                ;;
        esac
        ;;
    completions)
        declare -f _sygaldry_completions
        echo "complete -F _sygaldry_completions sygaldry"
        exit 0
        ;;
    k3s)
        shift
        case "${1:-}" in
            enter|"")
                shift 2>/dev/null || true
                exec "${SYGALDRY_HOME}/k3s/bin/kentai" "$@"
                ;;
            job)
                shift
                exec "${SYGALDRY_HOME}/k3s/bin/kjob" "$@"
                ;;
            setup)
                echo "Run these as root:" >&2
                echo "  sudo ${SYGALDRY_HOME}/k3s/bootstrap/install-k3s.sh" >&2
                echo "  sudo ${SYGALDRY_HOME}/k3s/bootstrap/setup-nvidia.sh" >&2
                exit 0
                ;;
            *)
                echo "Usage: sygaldry k3s [enter|job|setup]" >&2
                exit 2
                ;;
        esac
        ;;
    # No subcommand or unrecognized flags — pass everything to the launcher
    # This preserves backward compatibility with existing usage
    *)
        exec "${LAUNCHER}" "$@"
        ;;
esac

# ============================================================================
# Bash completion
# ============================================================================
# To enable tab completion, add to ~/.bash_completion or ~/.bashrc:
#   eval "$(sygaldry completions bash)"
# Or write to a completion file:
#   sygaldry completions bash > ~/.bash_completion.d/sygaldry

_sygaldry_completions() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local subcommands="shell run job config snapshot validate completions version k3s sail --help --repo"

    case "${prev}" in
        snapshot)
            mapfile -t COMPREPLY < <(compgen -W "spack hf-transformers hf-datasets vllm sglang torchtitan megatronlm llm-serving-all all --dry-run --push --no-verify" -- "${cur}")
            return ;;
        job)
            mapfile -t COMPREPLY < <(compgen -W "run status tail stop health" -- "${cur}")
            return ;;
        config)
            mapfile -t COMPREPLY < <(compgen -W "show" -- "${cur}")
            return ;;
        k3s)
            mapfile -t COMPREPLY < <(compgen -W "enter job setup" -- "${cur}")
            return ;;
        sail)
            mapfile -t COMPREPLY < <(compgen -W "discover worker cron analyze-run validate-plan --dry-run --repo-dir --run-id --artifacts-dir --issues-file --run-dir --output-dir" -- "${cur}")
            return ;;
        validate)
            mapfile -t COMPREPLY < <(compgen -W "--quick --verify-only --infra --infra-full --snapshot --snapshot-no-gpu --uv-layering --multi-repo" -- "${cur}")
            return ;;
    esac

    mapfile -t COMPREPLY < <(compgen -W "${subcommands}" -- "${cur}")
}
complete -F _sygaldry_completions sygaldry
