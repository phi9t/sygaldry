#!/usr/bin/env bash
set -eu -o pipefail

# Resolve SYGALDRY_HOME from this script's location (follows symlinks)
SYGALDRY_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export SYGALDRY_HOME

ZEPHYR_BIN="${SYGALDRY_HOME}/crates/zephyr/target/release/zephyr"
if [[ ! -x "${ZEPHYR_BIN}" ]]; then
    # Fallback: check PATH
    if command -v zephyr &>/dev/null; then
        ZEPHYR_BIN="$(command -v zephyr)"
    fi
fi

if [[ -x "${ZEPHYR_BIN}" ]]; then
    case "${1:-}" in
        sail)
            shift
            case "${1:-}" in
                status)
                    shift
                    exec python3 "${SYGALDRY_HOME}/tools/agentic/sail_status.py" \
                        --runtime-root "${SAIL_RUNTIME_ROOT:-/mnt/data_infra/zephyr_container_infra/sygaldry/logs/sail}" "$@"
                    ;;
                pause)
                    shift
                    _SAIL_RUNTIME_ROOT="${SAIL_RUNTIME_ROOT:-/mnt/data_infra/zephyr_container_infra/sygaldry/logs/sail}"
                    mkdir -p "${_SAIL_RUNTIME_ROOT}"
                    touch "${_SAIL_RUNTIME_ROOT}/cron.pause"
                    echo "SAIL paused"
                    ;;
                resume)
                    shift
                    _SAIL_RUNTIME_ROOT="${SAIL_RUNTIME_ROOT:-/mnt/data_infra/zephyr_container_infra/sygaldry/logs/sail}"
                    rm -f "${_SAIL_RUNTIME_ROOT}/cron.pause"
                    echo "SAIL resumed"
                    ;;
                discover)
                    shift
                    exec python3 "${SYGALDRY_HOME}/tools/agentic/discover_issues.py" \
                        --repo-dir "${SYGALDRY_HOME}" "$@"
                    ;;
                discover-major)
                    shift
                    exec python3 "${SYGALDRY_HOME}/tools/agentic/discover_major_challenges.py" \
                        --repo-dir "${SYGALDRY_HOME}" \
                        --runtime-root "${SAIL_RUNTIME_ROOT:-/mnt/data_infra/zephyr_container_infra/sygaldry/logs/sail}" \
                        --empty-streak "${SAIL_MAJOR_EMPTY_STREAK:-3}" \
                        --min-empty-streak "${SAIL_MAJOR_EMPTY_STREAK:-3}" "$@"
                    ;;
                worker)
                    shift
                    cd "${SYGALDRY_HOME}/temporal"
                    exec go run ./cmd/worker "$@"
                    ;;
                cron)
                    shift
                    exec "${SYGALDRY_HOME}/tools/agentic/sail_cron.sh" "$@"
                    ;;
                ensure-infra)
                    shift
                    exec "${SYGALDRY_HOME}/tools/agentic/sail_cron.sh" ensure-infra "$@"
                    ;;
                analyze-run)
                    shift
                    exec python3 "${SYGALDRY_HOME}/tools/agentic/analyze_sail_run.py" "$@"
                    ;;
                supervisor)
                    shift
                    exec python3 "${SYGALDRY_HOME}/tools/agentic/sail_supervisor.py" "$@"
                    ;;
                validate-plan)
                    shift
                    cd "${SYGALDRY_HOME}/temporal"
                    exec go run ./cmd/orchestrate validate \
                        -plan "${SYGALDRY_HOME}/tools/agentic/improvement_loop.yaml" "$@"
                    ;;
                *)
                    exec "${SYGALDRY_HOME}/tools/agentic/run_improvement_loop.sh" "$@"
                    ;;
            esac
            ;;
        snapshot)
            shift
            exec "${SYGALDRY_HOME}/container/snapshot_all.sh" "$@"
            ;;
        validate)
            shift
            exec "${SYGALDRY_HOME}/validate_all.sh" "$@"
            ;;
        completions)
            declare -f _sygaldry_completions
            echo "complete -F _sygaldry_completions sygaldry"
            exit 0
            ;;
        *)
            exec "${ZEPHYR_BIN}" "$@"
            ;;
    esac
fi

# Binary not found — print help and fail
echo "[sygaldry] Rust binary not found. Build with:" >&2
echo "  cd ${SYGALDRY_HOME} && cargo build -p zephyr --release" >&2
exit 127

# ============================================================================
# Bash completion
# ============================================================================
# To enable tab completion, add to ~/.bash_completion or ~/.bashrc:
#   eval "$(sygaldry completions bash)"
# Or write to a completion file:
#   sygaldry completions bash > ~/.bash_completion.d/sygaldry

_sygaldry_completions() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local subcommands="shell run job config snapshot validate completions version sail --help --repo"

    case "${prev}" in
        snapshot)
            mapfile -t COMPREPLY < <(compgen -W "spack hf-transformers hf-datasets vllm sglang torchtitan megatronlm llm-serving-all all --dry-run --push --no-verify" -- "${cur}")
            return ;;
        job)
            mapfile -t COMPREPLY < <(compgen -W "run status tail stop health" -- "${cur}")
            return ;;
        config)
            mapfile -t COMPREPLY < <(compgen -W "show" -- "${cur}")
            return ;;
        sail)
            mapfile -t COMPREPLY < <(compgen -W "status pause resume discover discover-major worker cron ensure-infra supervisor analyze-run validate-plan --dry-run --repo-dir --run-id --artifacts-dir --issues-file --run-dir --output-dir --once --no-fix --runtime-root --poll-secs --stall-secs --empty-streak --min-empty-streak --backlog-file --watch --json --runs" -- "${cur}")
            return ;;
        validate)
            mapfile -t COMPREPLY < <(compgen -W "--quick --verify-only --infra --infra-full --snapshot --snapshot-no-gpu --uv-layering --multi-repo" -- "${cur}")
            return ;;
    esac

    mapfile -t COMPREPLY < <(compgen -W "${subcommands}" -- "${cur}")
}
complete -F _sygaldry_completions sygaldry
