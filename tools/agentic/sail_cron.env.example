# Example environment for tools/agentic/sail_cron.sh
#
# Copy to:
#   /mnt/data_infra/zephyr_container_infra/sygaldry/config/sail-cron.env
# Or point SAIL_CRON_ENV_FILE at your custom path.

# Cron has a minimal PATH. Include the directories that provide the agent CLIs
# and repo toolchain on this host.
PATH=/home/phi9t/.local/bin:/home/phi9t/.nvm/versions/node/v24.13.0/bin:/mnt/data_infra/workspace/spack/var/spack/environments/argonaut/.spack-env/view/bin:/usr/local/bin:/usr/bin:/bin

# Persisted run artifacts, worker logs, lock file, and status JSON.
SAIL_RUNTIME_ROOT=/mnt/data_infra/zephyr_container_infra/sygaldry/logs/sail
SAIL_RETENTION_DAYS=30

# Temporal defaults. Keep these aligned with the worker.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=orchestration

# Optional engine overrides for unattended runs.
# Planning is local by default; leave planner settings unset unless you are
# explicitly testing agent-driven planning again.
# SAIL_PLANNER_ENGINE=local
# SAIL_PLANNER_MODEL=
# SAIL_IMPLEMENTER_ENGINE=codex
# SAIL_IMPLEMENTER_MODEL=
