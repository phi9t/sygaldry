# Example environment for tools/agentic/sail_cron.sh
#
# Copy to:
#   /mnt/data_infra/zephyr_container_infra/sygaldry/config/sail-cron.env
# Or point SAIL_CRON_ENV_FILE at your custom path.

# Cron has a minimal PATH. Include the directories that provide the agent CLIs
# and repo toolchain on this host.
PATH=/home/phi9t/.local/bin:/home/phi9t/.nvm/versions/node/v24.13.0/bin:/mnt/data_infra/workspace/spack/var/spack/environments/argonaut/.spack-env/view/bin:/usr/local/bin:/usr/bin:/bin

# Persisted run artifacts, worker logs, lock file, and status JSON.
SAIL_RUNTIME_ROOT=/mnt/data_infra/zephyr_container_infra/sygaldry/logs/sail
SAIL_RETENTION_DAYS=30

# Temporal defaults. Keep these aligned with the worker.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=orchestration

# Optional engine overrides for unattended runs.
# Planning is local by default; leave planner settings unset unless you are
# explicitly testing agent-driven planning again.
# SAIL_PLANNER_ENGINE=local
# SAIL_PLANNER_MODEL=
# SAIL_IMPLEMENTER_ENGINE=codex
# SAIL_IMPLEMENTER_MODEL=

# Optional major redesign challenge settings.
# When the primary unattended run discovers zero issues and emits zero
# synthetic self-improvement issues for SAIL_MAJOR_EMPTY_STREAK consecutive
# runs, cron may take one curated major redesign slice from the backlog file.
# SAIL_MAJOR_BACKLOG_FILE=/mnt/data_infra/workspace/sygaldry/tools/agentic/major_challenges.yaml
# SAIL_MAJOR_EMPTY_STREAK=3
# SAIL_MAJOR_PLANNER_ENGINE=claude
# SAIL_MAJOR_PLANNER_MODEL=claude-sonnet-4-6
# SAIL_MAJOR_MAX_CHANGED_FILES=8
# SAIL_MAJOR_MAX_CHANGED_LINES=600
# SAIL_MAJOR_MAX_FAILED_RUNS=3

# Optional supervisor settings.
# The supervisor writes supervisor_status.json and supervisor_events.jsonl under
# SAIL_RUNTIME_ROOT and defaults to Claude so agentsview sees the fix sessions.
# SAIL_SUPERVISOR_POLL_SECS=30
# SAIL_SUPERVISOR_STALL_SECS=1200
# SAIL_SUPERVISOR_FIX_COOLDOWN_SECS=300
# SAIL_SUPERVISOR_FIX_TIMEOUT_SECS=600
# SAIL_SUPERVISOR_MAX_FIX_TRIES=5
# SAIL_SUPERVISOR_FIX_ENGINE=claude
# SAIL_SUPERVISOR_FIX_MODEL=
