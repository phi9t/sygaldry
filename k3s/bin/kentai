#!/bin/bash
#
# kentai — Create, attach, and manage Sygaldry K3s dev pods.
#
# USAGE
# -----
#   kentai --project-id my-proj         # Create or attach to dev pod (--project-id required)
#   kentai --project-id my-proj --repo /path/to/repo  # Multi-repo mode
#   kentai --project-id my-proj --gpu 2               # Request 2 GPUs
#   kentai --project-id my-proj --image <image>        # Custom container image
#   kentai --project-id my-proj exec -- nvidia-smi     # One-off command in existing pod
#   kentai delete --project-id my-proj                 # Delete dev pod
#   kentai status --project-id my-proj                 # Pod status
#   kentai logs --project-id my-proj                   # Stream pod logs

set -eu -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly K3S_ROOT="${SCRIPT_DIR}/.."

# shellcheck source=../lib/k3s-common.sh
source "${K3S_ROOT}/lib/k3s-common.sh"

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
PROJECT_ID="${SYGALDRY_PROJECT_ID:-}"
GPU_COUNT="${SYGALDRY_GPU_COUNT:-1}"
CONTAINER_IMAGE="${SYGALDRY_IMAGE:-${CONTAINER_IMAGE_DEFAULT}}"
REPO_PATH=""
SUBCOMMAND="enter"
EXEC_ARGS=()

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
show_help() {
    cat <<'EOF'
Usage: kentai [subcommand] [options]

Subcommands:
  enter             Create or attach to dev pod (default)
  exec              Run one-off command in existing pod
  delete            Delete dev pod
  status            Show pod status
  logs              Stream pod logs

Options:
  --project-id <id>   Project ID [REQUIRED] (or set SYGALDRY_PROJECT_ID)
  --repo <path>       External repo path (enables multi-repo mode)
  --gpu <n>           Number of GPUs to request (default: 1)
  --image <image>     Container image (default: sygaldry/zephyr:base)
  --help              Show this help

Examples:
  kentai --project-id ml-train        # Interactive dev pod
  kentai --project-id ml-train --repo /path/to/repo  # Mount external repo
  kentai --project-id ml-train exec -- nvidia-smi     # Run command in pod
  kentai delete --project-id ml-train # Delete pod
EOF
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            enter|exec|delete|status|logs)
                SUBCOMMAND="$1"
                shift
                ;;
            --project-id)
                PROJECT_ID="$2"
                shift 2
                ;;
            --repo)
                REPO_PATH="$(realpath "$2")"
                shift 2
                ;;
            --gpu)
                GPU_COUNT="$2"
                shift 2
                ;;
            --image)
                CONTAINER_IMAGE="$2"
                shift 2
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --)
                shift
                EXEC_ARGS=("$@")
                break
                ;;
            *)
                echo "Unknown option: $1" >&2
                show_help
                exit 2
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Subcommand: enter
# ---------------------------------------------------------------------------
cmd_enter() {
    check_k3s
    check_namespace
    check_nvidia_runtime

    local name
    name="$(pod_name "${PROJECT_ID}")"
    local status
    status="$(pod_status "${name}")"

    case "${status}" in
        Running)
            log "Pod ${name} is running. Attaching to tmux session..."
            attach_tmux "${name}"
            ;;
        "")
            log "Pod ${name} does not exist. Creating..."
            create_pod
            wait_pod_ready "${name}" 120
            log "Attaching to tmux session..."
            sleep 2  # Give tmux a moment to start
            attach_tmux "${name}"
            ;;
        *)
            log "Pod ${name} is in state '${status}'. Deleting and recreating..."
            kubectl delete pod -n "${K3S_NAMESPACE}" "${name}" --grace-period=5 2>/dev/null || true
            kubectl wait --for=delete pod/"${name}" -n "${K3S_NAMESPACE}" --timeout=30s 2>/dev/null || true
            create_pod
            wait_pod_ready "${name}" 120
            log "Attaching to tmux session..."
            sleep 2
            attach_tmux "${name}"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Subcommand: exec
# ---------------------------------------------------------------------------
cmd_exec() {
    check_k3s

    local name
    name="$(pod_name "${PROJECT_ID}")"
    local status
    status="$(pod_status "${name}")"

    if [[ "${status}" != "Running" ]]; then
        die "Pod ${name} is not running (status: ${status:-not found})"
    fi

    if [[ ${#EXEC_ARGS[@]} -eq 0 ]]; then
        die "No command specified. Usage: kentai exec -- <command>"
    fi

    kubectl exec -it -n "${K3S_NAMESPACE}" "${name}" -- "${EXEC_ARGS[@]}"
}

# ---------------------------------------------------------------------------
# Subcommand: delete
# ---------------------------------------------------------------------------
cmd_delete() {
    check_k3s

    local name
    name="$(pod_name "${PROJECT_ID}")"

    if [[ -z "$(pod_status "${name}")" ]]; then
        log "Pod ${name} does not exist."
        return 0
    fi

    log "Deleting pod ${name}..."
    kubectl delete pod -n "${K3S_NAMESPACE}" "${name}" --grace-period=5
    log "Pod ${name} deleted."
}

# ---------------------------------------------------------------------------
# Subcommand: status
# ---------------------------------------------------------------------------
cmd_status() {
    check_k3s

    local name
    name="$(pod_name "${PROJECT_ID}")"
    local status
    status="$(pod_status "${name}")"

    if [[ -z "${status}" ]]; then
        echo "Pod ${name}: not found"
        return 1
    fi

    echo "Pod ${name}: ${status}"
    kubectl get pod -n "${K3S_NAMESPACE}" "${name}" -o wide 2>/dev/null
}

# ---------------------------------------------------------------------------
# Subcommand: logs
# ---------------------------------------------------------------------------
cmd_logs() {
    check_k3s

    local name
    name="$(pod_name "${PROJECT_ID}")"

    kubectl logs -n "${K3S_NAMESPACE}" "${name}" -f
}

# ---------------------------------------------------------------------------
# Pod creation
# ---------------------------------------------------------------------------
create_pod() {
    ensure_host_dirs "${PROJECT_ID}"

    local template
    local host_uid
    host_uid="$(id -u)"
    local host_gid
    host_gid="$(id -g)"

    if [[ -n "${REPO_PATH}" ]]; then
        template="${K3S_ROOT}/templates/dev-pod-multirepo.yaml"
        local repo_name
        repo_name="$(basename "${REPO_PATH}")"

        export PROJECT_ID HOST_UID="${host_uid}" HOST_GID="${host_gid}"
        export CONTAINER_IMAGE GPU_COUNT
        export REPO_HOST_PATH="${REPO_PATH}" REPO_NAME="${repo_name}"
    else
        template="${K3S_ROOT}/templates/dev-pod.yaml"

        export PROJECT_ID HOST_UID="${host_uid}" HOST_GID="${host_gid}"
        export CONTAINER_IMAGE GPU_COUNT
    fi

    log "Creating pod $(pod_name "${PROJECT_ID}") (image=${CONTAINER_IMAGE}, gpu=${GPU_COUNT})"
    envsubst < "${template}" | kubectl apply -f -
}

# ---------------------------------------------------------------------------
# tmux attachment
# ---------------------------------------------------------------------------
attach_tmux() {
    local name="$1"
    kubectl exec -it -n "${K3S_NAMESPACE}" "${name}" -- tmux attach -t main 2>/dev/null \
        || kubectl exec -it -n "${K3S_NAMESPACE}" "${name}" -- tmux new-session -A -s main
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
parse_args "$@"

if [[ -z "${PROJECT_ID}" ]]; then
    echo "ERROR: --project-id is required (or set SYGALDRY_PROJECT_ID)" >&2
    exit 1
fi

case "${SUBCOMMAND}" in
    enter)  cmd_enter ;;
    exec)   cmd_exec ;;
    delete) cmd_delete ;;
    status) cmd_status ;;
    logs)   cmd_logs ;;
    *)      die "Unknown subcommand: ${SUBCOMMAND}" ;;
esac
